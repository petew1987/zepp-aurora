{
  "configVersion": "v3",
  "app": {
    "appId": 1009876,
    "appName": "Aurora",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "Stealth Apps",
    "description": "Real-time Aurora Northern Lights likelihood tracker and forecast for Amazfit Active 3 using GPS, NOAA space weather, and Open-Meteo."
  },
  "packageInfo": {
    "mode": "preview"
  },
  "permissions": [
    "permission.GPS",
    "device:location",
    "device:os.bg_service"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "2.0.0",
      "target": "3.0.0",
      "minVersion": "2.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        },
        "app-widget": {
          "widgets": [
            {
              "name": "Aurora Widget",
              "path": "app-widget/index",
              "icon": "icon.png"
            }
          ]
        },
        "secondary-widget": {
          "widgets": [
            {
              "name": "Aurora Glance",
              "path": "secondary-widget/index",
              "icon": "icon.png"
            }
          ]
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 466
        },
        {
          "st": "s",
          "dw": 390
        }
      ],
      "designWidth": 466
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Aurora"
    }
  },
  "defaultLanguage": "en-US"
}
